{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance Widget",
  "version": "0.1.0",
  "identifier": "com.copypaster3000.finance-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finance Widget",
        "width": 474,
        "height": 700,
        "minWidth": 120,
        "minHeight": 192,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://query1.finance.yahoo.com; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Copypaster3000",
    "shortDescription": "A desktop finance and portfolio widget.",
    "longDescription": "A lightweight native Windows finance widget with a dated transaction ledger and restrained Linux-rice visual language.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
